{
  "manifest_version": 3,
  "name": "Let Us Block Them",
  "version": "1.2",
  "description": "Hide everyone in an FL group you choose: their posts, comments, notifications and messages leave your screen.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "letusblockthem@alatewolf",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://fetlife.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
